generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  service   String   @default("")
  budget    String   @default("")
  message   String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([read])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String   @default("")
  userAgent String   @default("")
  screen    String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}

model AdminUser {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String?          @default("Team Member")
  passwordHash String
  role         String           @default("member") // superadmin, admin, member
  avatar       String?
  lastLoginAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt @default(now())
  invoices     Invoice[]
  invitesSent  AdminWhitelist[] @relation("InvitedBy")
}

model AdminWhitelist {
  id               String     @id @default(cuid())
  email            String     @unique
  role             String     @default("member") // superadmin, admin, member
  status           String     @default("pending") // pending, active, revoked
  inviteToken      String?    @unique
  verificationCode String?
  codeExpiresAt    DateTime?
  invitedById      String?
  invitedBy        AdminUser? @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([email])
  @@index([status])
}

model Invoice {
  id             String    @id @default(cuid())
  invoiceNumber  String
  clientName     String
  clientAddress  String    @default("")
  date           String
  dueDate        String?   @default("")
  currency       String    @default("$")
  paymentMethod  String    @default("Check")
  checkNo        String?   @default("")
  paymentDetails String?   @default("")
  paid           Boolean   @default(false)
  showSeal       Boolean   @default(true)
  items          Json      @default("[]")
  subtotal       Float     @default(0)
  totalAmount    Float     @default(0)
  notes          String?   @default("")
  createdById    String
  createdBy      AdminUser @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([createdById, createdAt])
  @@index([invoiceNumber])
}

model CaseStudy {
  id          String   @id @default(cuid())
  slug        String   @unique
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)

  // Card-level (homepage + listing)
  client      String
  logo        String   @default("")
  category    String
  title       String
  description String   @default("")
  coverImage  String   @default("")
  metric      String   @default("")
  metricLabel String   @default("")
  tags        String[] @default([])

  // Detail page
  headline    String   @default("")
  subtitle    String   @default("")
  tech        String[] @default([])
  challenge   String   @default("")
  solution    String   @default("")
  videoUrl    String   @default("")

  // JSON fields
  stats       Json     @default("[]")
  gallery     Json     @default("[]")
  features    Json     @default("[]")
  sections    Json     @default("[]")
  results     Json     @default("[]")

  // CTA
  ctaEyebrow  String   @default("")
  ctaHeading  String   @default("")
  ctaAccent   String   @default("")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
  @@index([slug])
}

model JobPosting {
  id           String           @id @default(cuid())
  title        String
  type         String           // e.g. "Full-time · Remote"
  dept         String           // e.g. "Engineering", "Design"
  desc         String
  published    Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  applications JobApplication[]

  @@index([published])
}

model JobApplication {
  id           String      @id @default(cuid())
  name         String
  email        String
  phone        String?
  linkedin     String?
  resumeUrl    String      // Path to uploaded resume
  coverLetter  String?     @default("")
  jobPostingId String?     // Nullable for spontaneous application
  jobPosting   JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  read         Boolean     @default(false)
  createdAt    DateTime    @default(now())

  @@index([createdAt])
  @@index([read])
}

model ChatSession {
  id             String        @id @default(cuid())
  sessionKey     String        @unique
  visitorName    String?
  visitorEmail   String?
  visitorPhone   String?
  visitorCompany String?
  leadStatus     String        @default("new") // new, contacted, qualified, proposal, won, archived
  leadScore      Int           @default(10)     // 1 to 100
  budget         String?
  timeline       String?
  projectScope   String?
  notes          String?       @default("")
  ipAddress      String?
  userAgent      String?
  referrer       String?
  unreadByAdmin  Boolean       @default(true)
  lastMessageAt  DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  messages       ChatMessage[]

  @@index([createdAt])
  @@index([lastMessageAt])
  @@index([leadStatus])
  @@index([unreadByAdmin])
}

model ChatMessage {
  id         String      @id @default(cuid())
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender     String      // user, assistant, system, tool
  content    String
  toolName   String?
  toolArgs   Json?
  toolResult Json?
  createdAt  DateTime    @default(now())

  @@index([sessionId, createdAt])
}
